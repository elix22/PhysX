<?xml version="1.0" encoding="utf-8"?>
<preset name="ios-clang-x86_64-simulator" comment="iOS x86_64 (simulator) clang PhysX SDK settings - no snippets">
  <platform targetPlatform="ios64" compiler="clang" />
  <CMakeSwitches>
    <cmakeSwitch name="PX_BUILDSNIPPETS" value="False" comment="Disable snippets (GLUT not available on iOS)" />
    <cmakeSwitch name="PX_BUILDPVDRUNTIME" value="True" comment="Generate the OmniPVD project" />
    <cmakeSwitch name="PX_GENERATE_STATIC_LIBRARIES" value="True" comment="Generate static libs (required for iOS)" />    
  </CMakeSwitches>
  <CMakeParams>
    <cmakeParam name="CMAKE_INSTALL_PREFIX" value="install/ios-clang-x86_64-simulator/PhysX" comment="Install path relative to PhysX SDK root" />
    <cmakeParam name="CMAKE_SYSTEM_NAME" value="iOS" comment="Target iOS system" />
    <cmakeParam name="CMAKE_OSX_ARCHITECTURES" value="x86_64" comment="Target x86_64 architecture (iOS simulator)" />
    <cmakeParam name="CMAKE_OSX_DEPLOYMENT_TARGET" value="12.0" comment="Minimum iOS version (iOS 12.0+)" />
    <cmakeParam name="CMAKE_OSX_SYSROOT" value="iphonesimulator" comment="Use iPhone Simulator SDK" />
    <cmakeParam name="CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH" value="NO" comment="Build for all architectures" />
    <cmakeParam name="CMAKE_XCODE_ATTRIBUTE_VALID_ARCHS" value="x86_64" comment="Valid architectures for iOS simulator" />
  </CMakeParams>
</preset>
