<?xml version="1.0" encoding="utf-8"?>
<preset name="macos-clang-arm64-cpu-only-xcode" comment="macOS ARM64 CPU-only Xcode preset for debugging">
	<platform targetPlatform="macArm64" compiler="xcode" />
	<cmakeGenerator name="Xcode" />
	<CMakeSwitches>
		<cmakeSwitch name="PX_BUILDSNIPPETS" value="True" comment="Generate the snippets for debugging" />
		<cmakeSwitch name="PX_BUILDPVDRUNTIME" value="True" comment="Generate the OmniPVD project" />
		<cmakeSwitch name="PX_GENERATE_STATIC_LIBRARIES" value="True" comment="Generate static libs" />
		<cmakeSwitch name="PX_FLOAT_POINT_PRECISE_MATH" value="False" comment="Disable precise math for better performance" />
	</CMakeSwitches>
	<CMakeParams>
		<cmakeParam name="CMAKE_INSTALL_PREFIX" value="install/macos-clang-arm64-cpu-only-xcode/PhysX" comment="Install path relative to PhysX SDK root" />
		<cmakeParam name="CMAKE_OSX_ARCHITECTURES" value="arm64" comment="Target ARM64 architecture (Apple Silicon native)" />
		<cmakeParam name="CMAKE_OSX_DEPLOYMENT_TARGET" value="11.0" comment="Minimum macOS version (Big Sur - first macOS with Apple Silicon support)" />
		<cmakeParam name="CMAKE_CONFIGURATION_TYPES" value="Debug;Release;Profile;Checked" comment="Build configurations for Xcode" />
		<cmakeParam name="CMAKE_XCODE_GENERATE_SCHEME" value="ON" comment="Generate Xcode schemes for targets" />
		<cmakeParam name="CMAKE_XCODE_ATTRIBUTE_DEBUG_INFORMATION_FORMAT" value="dwarf-with-dsym" comment="Debug symbols format" />
		<cmakeParam name="CMAKE_XCODE_ATTRIBUTE_GCC_GENERATE_DEBUGGING_SYMBOLS" value="YES" comment="Generate debugging symbols" />
	</CMakeParams>
</preset>
